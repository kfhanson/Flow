{
  "product": {
    "name": "Flow",
    "type": "premium Indonesian shoe and sneaker showcase",
    "stage": "in_progress"
  },
  "brand": {
    "primaryColors": ["black", "red"],
    "wordmarkColor": "red",
    "tone": [
      "premium",
      "cinematic",
      "editorial",
      "modern",
      "fashion-forward"
    ]
  },
  "routes": [
    {
      "path": "/",
      "name": "showcase",
      "description": "Single-page product showcase and ecommerce-style experience"
    },
    {
      "path": "/support",
      "name": "support",
      "description": "Customer support page with video-led templated answers"
    }
  ],
  "features": [
    {
      "id": "hero-scroll-sequence",
      "title": "Scroll-driven hero sequence",
      "status": "in_progress",
      "behavior": {
        "trigger": "user scroll",
        "media": "PixVerse-generated product videos",
        "updates": [
          "shared home-page background video changes by dominant section",
          "hero headline and product metadata update per scene",
          "timeline or progress rail reflects current position",
          "story and commerce sections inherit discrete media moods"
        ],
        "rendering": "full-screen sticky backdrop with section-triggered transitions"
      }
    },
    {
      "id": "brand-story",
      "title": "Brand story section",
      "status": "in_progress",
      "behavior": {
        "goal": "Explain Flow's premium Indonesian identity",
        "presentation": [
          "editorial layout",
          "manifesto-style copy",
          "cinematic visual treatment",
          "full-page panel"
        ]
      }
    },
    {
      "id": "product-variants",
      "title": "Variant exploration",
      "status": "in_progress",
      "behavior": {
        "content": [
          "product name",
          "colorway",
          "materials",
          "price",
          "alternate angles or thumbnails"
        ],
        "actions": [
          "select or preview a variant",
          "add item to cart"
        ],
        "layout": "full-page panel"
      }
    },
    {
      "id": "reviews",
      "title": "Reviews section",
      "status": "in_progress",
      "behavior": {
        "content": [
          "aggregate score",
          "customer quotes",
          "editorial pull quotes"
        ],
        "presentation": "curated and premium, not marketplace-generic",
        "layout": "full-page panel"
      }
    },
    {
      "id": "cart-summary",
      "title": "Cart popup",
      "status": "in_progress",
      "behavior": {
        "state": [
          "selected items",
          "quantities",
          "subtotal"
        ],
        "interaction": [
          "click cart pill in header to open/close",
          "adding a product auto-opens cart",
          "remove item, quantity +/-",
          "clear cart"
        ],
        "presentation": "navbar popup drawer",
        "scope": "intent-focused cart without full transactional checkout"
      }
    },
    {
      "id": "support-video-answers",
      "title": "Support page with templated video answers",
      "status": "planned",
      "behavior": {
        "media": "PixVerse-generated support host video",
        "questions": [
          "shipping in Indonesia",
          "international shipping",
          "size guidance",
          "authenticity guarantee",
          "returns and exchanges",
          "payment options",
          "order tracking",
          "product care"
        ],
        "interaction": [
          "user selects a templated question",
          "answer panel updates",
          "video cue and supporting copy stay synchronized"
        ],
        "contentSource": "support-qa.json"
      }
    }
  ],
  "constraints": {
    "architecture": "frontend-only for initial hackathon build",
    "data": "local typed mock data",
    "designApproach": "desktop-first",
    "motionRule": "premium and restrained, never noisy"
  }
}
